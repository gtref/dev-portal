---
import type { Profile } from '../lib/supabase';

const { profile } = Astro.props as { profile?: Partial<Profile> };
const listValue = (value?: string[] | null) => value?.join(', ') ?? '';
---

<form id="profile-form" class="space-y-6 max-w-2xl bg-slate-800/80 p-6 md:p-8 rounded-xl border border-slate-700 shadow-xl">
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<div class="space-y-2">
			<label class="block text-sm font-medium text-slate-200">Name <span class="text-sky-400">*</span></label>
			<input name="name" class="input-field" value={profile?.name ?? ''} required placeholder="Ada Lovelace" />
		</div>

		<div class="space-y-2">
			<label class="block text-sm font-medium text-slate-200">GitHub</label>
			<input name="github" class="input-field" value={profile?.github ?? ''} placeholder="username or profile URL" />
		</div>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
		<div class="space-y-2">
			<label class="block text-sm font-medium text-slate-200">Website</label>
			<input name="website" type="url" class="input-field" value={profile?.website ?? ''} placeholder="https://example.com" />
		</div>

		<div class="space-y-2">
			<label class="block text-sm font-medium text-slate-200">Blog</label>
			<input name="blog" type="url" class="input-field" value={profile?.blog ?? ''} placeholder="https://blog.example.com" />
		</div>
	</div>

	<div class="space-y-2">
		<label class="block text-sm font-medium text-slate-200">Skill Level / Role</label>
		<input name="skill_level" class="input-field" value={profile?.skill_level ?? ''} placeholder="e.g. Senior Fullstack Engineer" />
	</div>

	<div class="space-y-2">
		<label class="block text-sm font-medium text-slate-200">Bio</label>
		<textarea name="bio" rows="4" class="input-field" placeholder="Tell us about yourself and what you're working on...">{profile?.bio ?? ''}</textarea>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
		<div class="space-y-2">
			<label class="block text-sm font-medium text-slate-200">Languages</label>
			<input name="languages" class="input-field" value={listValue(profile?.languages)} placeholder="TypeScript, Python, Rust" />
		</div>

		<div class="space-y-2">
			<label class="block text-sm font-medium text-slate-200">Tools</label>
			<input name="tools" class="input-field" value={listValue(profile?.tools)} placeholder="Git, Docker, VS Code" />
		</div>

		<div class="space-y-2">
			<label class="block text-sm font-medium text-slate-200">Stacks</label>
			<input name="stacks" class="input-field" value={listValue(profile?.stacks)} placeholder="Astro, Supabase, React" />
		</div>
	</div>

	<div class="pt-4 flex items-center justify-between border-t border-slate-700/80">
		<button type="submit" class="btn-primary">
			Save Profile
		</button>
		<p id="profile-status" class="text-sm font-medium text-sky-400" role="status"></p>
	</div>
</form>

<script>
	import { createClient } from '../lib/supabase';

	const form = document.querySelector<HTMLFormElement>('#profile-form');
	const status = document.querySelector<HTMLElement>('#profile-status');
	const client = createClient();
	const base = import.meta.env.BASE_URL;

	if (form && status) {
		const { data: { user } } = await client.auth.getUser();
		if (!user) {
			window.location.href = `${base}login/`;
		} else {
			const { data, error } = await client.from('profiles').select('*').eq('id', user.id).maybeSingle();
			if (error) {
				status.textContent = error.message;
			} else if (data) {
				for (const field of ['name', 'github', 'website', 'blog', 'bio', 'skill_level', 'languages', 'tools', 'stacks']) {
					const input = form.elements.namedItem(field);
					if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
						const value = data[field];
						input.value = Array.isArray(value) ? value.join(', ') : value ?? '';
					}
				}
			}
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			status.textContent = 'Saving profile...';
			const { data: { session } } = await client.auth.getSession();
			if (!session?.user) {
				window.location.href = `${base}login/`;
				return;
			}
			const values = new FormData(form);
			const list = (name: string) => String(values.get(name) ?? '').split(',').map((item) => item.trim()).filter(Boolean);
			const profileData = {
				id: session.user.id,
				name: String(values.get('name') ?? '').trim(),
				github: String(values.get('github') ?? '').trim(),
				website: String(values.get('website') ?? '').trim(),
				blog: String(values.get('blog') ?? '').trim(),
				bio: String(values.get('bio') ?? '').trim(),
				skill_level: String(values.get('skill_level') ?? '').trim(),
				languages: list('languages'),
				tools: list('tools'),
				stacks: list('stacks'),
				updated_at: new Date().toISOString(),
			};

			const { error } = await client.from('profiles').upsert(profileData);
			if (error) {
				status.textContent = error.message;
				status.className = 'text-sm font-medium text-rose-400';
			} else {
				status.textContent = 'Profile saved successfully!';
				status.className = 'text-sm font-medium text-emerald-400';
			}
		});
	}
</script>
