---
<!doctype html>
<html lang="en">
	<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Log in | Dev Portal</title></head>
	<body>
		<main>
			<h1>Log in</h1>
			<form id="login-form">
				<label>Email <input name="email" type="email" autocomplete="email" required /></label>
				<label>Password <input name="password" type="password" autocomplete="current-password" required /></label>
				<button type="submit">Log in</button>
			</form>
			<button id="github-login" type="button">Continue with GitHub</button>
			<p id="auth-status" role="status"></p>
			<a href={`${import.meta.env.BASE_URL}signup/`}>Create an account</a>
		</main>
	</body>
</html>

<script>
	import { createClient } from '../lib/supabase';
	const client = createClient();
	const base = import.meta.env.BASE_URL;
	const form = document.querySelector<HTMLFormElement>('#login-form');
	const status = document.querySelector<HTMLElement>('#auth-status');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!status || !form) return;
		const values = new FormData(form);
		const { error } = await client.auth.signInWithPassword({ email: String(values.get('email')), password: String(values.get('password')) });
		if (error) status.textContent = error.message;
		else window.location.href = `${base}dashboard/`;
	});
	document.querySelector('#github-login')?.addEventListener('click', async () => {
		const redirectTo = import.meta.env.PUBLIC_GITHUB_REDIRECT_URL || new URL(`${base}callback`, window.location.origin).toString();
		const { error } = await client.auth.signInWithOAuth({ provider: 'github', options: { redirectTo } });
		if (error && status) status.textContent = error.message;
	});
</script>

<style>
	body { max-width: 560px; margin: 3rem auto; padding: 1rem; font-family: system-ui, sans-serif; }
	main, form, label { display: grid; gap: 1rem; }
	input { padding: 0.65rem; font: inherit; }
</style>