---
import ProfileCard from '../components/ProfileCard.astro';
import { createClient, isSupabaseConfigured } from '../lib/supabase';

	const { data, error } = isSupabaseConfigured
	? await createClient().from('profiles').select('id, name, github, skill_level').limit(6)
	: { data: [], error: null };
const profiles = data ?? [];
const initialStatus = error?.message ?? (!isSupabaseConfigured ? 'Supabase is not configured for this deployment.' : profiles.length === 0 ? 'No profiles to show yet.' : '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Dev Portal</title>
	</head>
	<body>
		<header>
			<a href={import.meta.env.BASE_URL}>Dev Portal</a>
			<nav aria-label="Main navigation">
				<a href={`${import.meta.env.BASE_URL}explore/`}>Explore</a>
				<a href={`${import.meta.env.BASE_URL}login/`}>Log in</a>
				<a href={`${import.meta.env.BASE_URL}signup/`}>Sign up</a>
			</nav>
		</header>
		<main>
			<h1>Developer profiles</h1>
			<section aria-labelledby="featured-heading">
				<h2 id="featured-heading">Featured Profiles</h2>
				<div id="featured-profiles" class="profiles">
					{profiles.map((profile) => <ProfileCard profile={profile} />)}
				</div>
				<p id="featured-status" role="status">{initialStatus}</p>
			</section>
		</main>
	</body>
</html>

<script>
	import { createClient, isSupabaseConfigured } from '../lib/supabase';

	if (isSupabaseConfigured) {
		const container = document.querySelector<HTMLElement>('#featured-profiles');
		const status = document.querySelector<HTMLElement>('#featured-status');
		const { data, error } = await createClient().from('profiles').select('id, name, github, skill_level').limit(6);
		if (status) status.textContent = error?.message ?? ((data?.length ?? 0) === 0 ? 'No profiles to show yet.' : '');
		if (container && data) {
			container.replaceChildren();
			for (const profile of data) {
				const card = document.createElement('article');
				card.className = 'profile-card';
				const name = document.createElement('h3');
				name.textContent = profile.name || 'Developer';
				const level = document.createElement('p');
				level.textContent = profile.skill_level || 'Skill level not specified';
				card.append(name, level);
				if (profile.github) {
					const github = document.createElement('a');
					github.href = profile.github.startsWith('http') ? profile.github : `https://github.com/${profile.github.replace(/^@/, '')}`;
					github.textContent = 'GitHub';
					github.target = '_blank';
					github.rel = 'noreferrer';
					card.append(github);
				}
				const link = document.createElement('a');
				link.href = `${import.meta.env.BASE_URL}u/${profile.id}/`;
				link.textContent = 'View profile';
				card.append(link);
				container.append(card);
			}
		}
	}
</script>

<style>
	:global(body) { max-width: 960px; margin: 0 auto; padding: 2rem; font-family: system-ui, sans-serif; color: #18212b; }
	header, nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	a { color: #145b50; }
	.profiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
</style>
