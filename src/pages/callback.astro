<!doctype html>
<html lang="en">
	<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Signing in | Dev Portal</title></head>
	<body>
		<main>
			<h1>Signing in</h1>
			<p id="auth-status" role="status">Completing GitHub sign-in...</p>
		</main>
	</body>
</html>

<script>
	import { createClient } from '../lib/supabase';

	const client = createClient();
	const status = document.querySelector<HTMLElement>('#auth-status');
	const base = import.meta.env.BASE_URL;
	const { data: { session }, error } = await client.auth.getSession();

	if (error || !session) {
		if (status) status.textContent = error?.message ?? 'Could not complete sign-in.';
	} else {
		window.location.replace(`${base}dashboard/`);
	}
</script>

<style>
	body { max-width: 560px; margin: 3rem auto; padding: 1rem; font-family: system-ui, sans-serif; }
</style>