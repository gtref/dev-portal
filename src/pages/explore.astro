---
import ProfileCard from '../components/ProfileCard.astro';
import HeaderNav from '../components/HeaderNav.astro';
import { createClient, isSupabaseConfigured } from '../lib/supabase';
import '../styles/global.css';

const { data, error } = isSupabaseConfigured
	? await createClient().from('profiles').select('id, name, github, bio, skill_level').order('name')
	: { data: [], error: null };
const profiles = data ?? [];
const initialStatus = error?.message ?? (!isSupabaseConfigured ? 'Supabase is not configured for this deployment.' : profiles.length === 0 ? 'No profiles found.' : '');
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Explore Developers | Dev Portal</title>
	</head>
	<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">
		<header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50">
			<div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
				<a href={import.meta.env.BASE_URL} class="text-xl font-bold bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent">
					Dev Portal
				</a>
				<HeaderNav />
			</div>
		</header>

		<main class="flex-grow max-w-6xl w-full mx-auto px-4 py-10 space-y-8">
			<div>
				<h1 class="text-3xl font-extrabold text-white">Explore Developers</h1>
				<p class="text-slate-400 mt-1">Browse and search profiles from developers around the world.</p>
			</div>

			<div id="all-profiles" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{profiles.map((profile) => <ProfileCard profile={profile} />)}
			</div>

			<p id="explore-status" class="text-center text-slate-400 py-6" role="status">{initialStatus}</p>
		</main>

		<footer class="border-t border-slate-800 py-8 bg-slate-950 text-slate-500 text-center text-sm">
			<div class="max-w-6xl mx-auto px-4">
				&copy; {new Date().getFullYear()} Dev Portal. Built with Astro & Supabase.
			</div>
		</footer>
	</body>
</html>

<script>
	import { createClient, isSupabaseConfigured } from '../lib/supabase';

	if (isSupabaseConfigured) {
		const container = document.querySelector<HTMLElement>('#all-profiles');
		const status = document.querySelector<HTMLElement>('#explore-status');
		const { data, error } = await createClient().from('profiles').select('id, name, github, bio, skill_level').order('name');
		if (status) status.textContent = error?.message ?? ((data?.length ?? 0) === 0 ? 'No profiles found.' : '');
		if (container && data && data.length > 0) {
			container.replaceChildren();
			for (const profile of data) {
				const card = document.createElement('article');
				card.className = 'profile-card';

				const topDiv = document.createElement('div');
				topDiv.className = 'flex justify-between items-start';

				const name = document.createElement('h3');
				name.className = 'text-xl font-bold text-slate-100';
				name.textContent = profile.name || 'Developer';
				topDiv.append(name);

				if (profile.skill_level) {
					const level = document.createElement('span');
					level.className = 'badge';
					level.textContent = profile.skill_level;
					topDiv.append(level);
				}

				const bio = document.createElement('p');
				bio.className = 'text-slate-400 text-sm line-clamp-2';
				bio.textContent = profile.bio || 'No bio provided.';

				const bottomDiv = document.createElement('div');
				bottomDiv.className = 'mt-auto pt-3 flex items-center justify-between border-t border-slate-700/60 text-sm';

				if (profile.github) {
					const github = document.createElement('a');
					github.href = profile.github.startsWith('http') ? profile.github : `https://github.com/${profile.github.replace(/^@/, '')}`;
					github.textContent = 'GitHub';
					github.target = '_blank';
					github.rel = 'noreferrer';
					github.className = 'text-sky-400 hover:text-sky-300 font-medium';
					bottomDiv.append(github);
				} else {
					const noGithub = document.createElement('span');
					noGithub.className = 'text-slate-500';
					noGithub.textContent = 'No GitHub';
					bottomDiv.append(noGithub);
				}

				const link = document.createElement('a');
				link.href = `${import.meta.env.BASE_URL}u/${profile.id}/`;
				link.textContent = 'View profile →';
				link.className = 'text-slate-300 hover:text-white font-medium underline-offset-4 hover:underline';
				bottomDiv.append(link);

				card.append(topDiv, bio, bottomDiv);
				container.append(card);
			}
		}
	}
</script>
