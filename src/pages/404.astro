---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>404 - Page Not Found | Dev Portal</title>
	</head>
	<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4">
		<main class="text-center space-y-6 max-w-md">
			<div class="space-y-2">
				<h1 class="text-6xl font-extrabold text-sky-400">404</h1>
				<h2 class="text-2xl font-bold text-white">Page not found</h2>
				<p class="text-slate-400">Sorry, we couldn't find the page you're looking for.</p>
			</div>
			<a href={import.meta.env.BASE_URL} class="btn-primary">Return Home</a>
		</main>
	</body>
</html>
