---
import { createClient, isSupabaseConfigured, type Profile } from '../../lib/supabase';
import '../../styles/global.css';

export async function getStaticPaths() {
	if (!isSupabaseConfigured) return [];
	const { data } = await createClient().from('profiles').select('id');
	return (data ?? []).map(({ id }) => ({ params: { id } }));
}

const profileId = Astro.params.id;
const { data } = isSupabaseConfigured
	? await createClient().from('profiles').select('*').eq('id', profileId).maybeSingle()
	: { data: null };
const profile = data as Profile | null;
const external = (url?: string | null) => url ? (url.startsWith('http') ? url : `https://${url}`) : null;
const githubUrl = profile?.github
	? (profile.github.startsWith('http') ? profile.github : `https://github.com/${profile.github.replace(/^@/, '')}`)
	: null;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{profile?.name ?? 'Developer Profile'} | Dev Portal</title>
	</head>
	<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">
		<header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50">
			<div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
				<a href={import.meta.env.BASE_URL} class="text-xl font-bold bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent">
					Dev Portal
				</a>
				<nav aria-label="Main navigation" class="flex items-center gap-6">
					<a href={`${import.meta.env.BASE_URL}explore/`} class="text-slate-300 hover:text-white transition-colors text-sm font-medium">Explore</a>
					<a href={`${import.meta.env.BASE_URL}login/`} class="btn-secondary text-sm">Log in</a>
				</nav>
			</div>
		</header>

		<main class="flex-grow max-w-4xl w-full mx-auto px-4 py-10">
			{profile ? (
				<article class="bg-slate-800/90 border border-slate-700 rounded-2xl p-6 sm:p-10 shadow-2xl space-y-8">
					<div class="space-y-3 border-b border-slate-700 pb-6">
						<div class="flex flex-wrap items-center justify-between gap-4">
							<h1 class="text-3xl sm:text-4xl font-extrabold text-white">{profile.name || 'Developer'}</h1>
							{profile.skill_level && <span class="badge text-sm py-1 px-3">{profile.skill_level}</span>}
						</div>
						{profile.bio && <p class="text-slate-300 text-lg leading-relaxed">{profile.bio}</p>}
					</div>

					<!-- Technical Profile Grid -->
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
						{profile.languages && profile.languages.length > 0 && (
							<div class="space-y-2">
								<h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Languages</h3>
								<div class="flex flex-wrap gap-2">
									{profile.languages.map((lang) => (
										<span class="px-2.5 py-1 rounded-md bg-slate-700/80 text-sky-300 text-xs font-medium">{lang}</span>
									))}
								</div>
							</div>
						)}

						{profile.tools && profile.tools.length > 0 && (
							<div class="space-y-2">
								<h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tools</h3>
								<div class="flex flex-wrap gap-2">
									{profile.tools.map((tool) => (
										<span class="px-2.5 py-1 rounded-md bg-slate-700/80 text-emerald-300 text-xs font-medium">{tool}</span>
									))}
								</div>
							</div>
						)}

						{profile.stacks && profile.stacks.length > 0 && (
							<div class="space-y-2">
								<h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Stacks</h3>
								<div class="flex flex-wrap gap-2">
									{profile.stacks.map((stack) => (
										<span class="px-2.5 py-1 rounded-md bg-slate-700/80 text-indigo-300 text-xs font-medium">{stack}</span>
									))}
								</div>
							</div>
						)}
					</div>

					<!-- Social & Web Links -->
					<div class="pt-6 border-t border-slate-700 flex flex-wrap gap-4">
						{githubUrl && (
							<a href={githubUrl} target="_blank" rel="noreferrer" class="btn-secondary text-sm">
								<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
								GitHub
							</a>
						)}
						{external(profile.website) && (
							<a href={external(profile.website)!} target="_blank" rel="noreferrer" class="btn-secondary text-sm">
								Website ↗
							</a>
						)}
						{external(profile.blog) && (
							<a href={external(profile.blog)!} target="_blank" rel="noreferrer" class="btn-secondary text-sm">
								Blog ↗
							</a>
						)}
					</div>
				</article>
			) : (
				<div class="text-center py-20 space-y-4">
					<h2 class="text-2xl font-bold text-slate-300">Profile Not Found</h2>
					<p class="text-slate-400">The developer profile you are looking for does not exist or has been removed.</p>
					<a href={`${import.meta.env.BASE_URL}explore/`} class="btn-primary inline-block">Explore Other Developers</a>
				</div>
			)}
		</main>

		<footer class="border-t border-slate-800 py-8 bg-slate-950 text-slate-500 text-center text-sm mt-auto">
			<div class="max-w-6xl mx-auto px-4">
				&copy; {new Date().getFullYear()} Dev Portal. Built with Astro & Supabase.
			</div>
		</footer>
	</body>
</html>
