---
import ProfileEditor from '../components/ProfileEditor.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Dashboard | Dev Portal</title>
	</head>
	<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">
		<header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50">
			<div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
				<a href={import.meta.env.BASE_URL} class="text-xl font-bold bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent">
					Dev Portal
				</a>
				<nav aria-label="Main navigation" class="flex items-center gap-6">
					<a href={`${import.meta.env.BASE_URL}explore/`} class="text-slate-300 hover:text-white transition-colors text-sm font-medium">Explore</a>
					<button id="logout-btn" class="btn-secondary text-sm">Sign out</button>
				</nav>
			</div>
		</header>

		<main class="flex-grow max-w-4xl w-full mx-auto px-4 py-10 space-y-8">
			<div>
				<h1 class="text-3xl font-extrabold text-white">Your Developer Profile</h1>
				<p class="text-slate-400 mt-1">Manage and update your public developer profile information.</p>
			</div>

			<ProfileEditor />
		</main>

		<footer class="border-t border-slate-800 py-8 bg-slate-950 text-slate-500 text-center text-sm">
			<div class="max-w-6xl mx-auto px-4">
				&copy; {new Date().getFullYear()} Dev Portal. Built with Astro & Supabase.
			</div>
		</footer>
	</body>
</html>

<script>
	import { createClient } from '../lib/supabase';

	const client = createClient();
	const logoutBtn = document.querySelector<HTMLButtonElement>('#logout-btn');

	logoutBtn?.addEventListener('click', async () => {
		await client.auth.signOut();
		window.location.href = import.meta.env.BASE_URL;
	});
</script>
